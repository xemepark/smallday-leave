rules_version = '2';
// 小日子劃假系統（Firestore 版）安全規則
// 重點：同仁只能劃／取消「自己的自排」，而且一定要在開放中（手動開放，或預約時間內且沒有手動暫停）、名額還有；設定和代排只有管理員能改。
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth != null && request.auth.token.email_verified == true
        ? request.auth.token.email.lower() : '';
    }
    function cfg() { return get(/databases/$(database)/documents/cfg/main).data; }
    function isOwner() { return email() == 'xemepark@gmail.com'; }
    function isAdmin() { return isOwner() || (email() != '' && email() in cfg().admins); }
    function isStaff() {
      return email() != '' && email() in cfg().staffMap && cfg().staffMap[email()].active == true;
    }
    function isMember() { return isAdmin() || isStaff(); }

    // 設定：大家都能讀，只有管理員能改
    match /cfg/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 每個月的排休
    match /months/{m} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() && (staffChange(m) || staffSubmit(m)));
    }

    // 劃假狀態：開放＝手動開放、暫停＝手動暫停（都優先於預約時間）；其他＝依預約開放／結束時間
    function windowOpen(w, now) {
      let mode = w.get('mode', '自動');
      return mode == '開放' || (mode != '暫停' && now >= w.openMs && now <= w.closeMs);
    }

    // 同仁劃／取消自己的一筆自排
    function staffChange(m) {
      let c = cfg();
      let me = email();
      let now = request.time.toMillis();
      let a = request.resource.data;
      let b = resource.data;
      let k = a.last.k;
      let s = a.last.s;
      return windowOpen(c.window, now)
        && a.diff(b).affectedKeys().hasOnly(['b', 'c', 'last'])
        && a.b.diff(b.b).affectedKeys().hasOnly([k])
        && a.c.diff(b.c).affectedKeys().hasOnly([s])
        && (a.last.op == 'add'
          ? staffAdd(m, a, b, k, s, me, c.staffMap[me])
          : (a.last.op == 'del' && staffDel(a, b, k, s, me, c.staffMap[me])));
    }
    // 同仁可以自己動的假：自排、許願、事假／病假／特休申請
    function staffType(t) { return t in ['自排', '許願', '事假申請', '病假申請', '特休申請']; }
    // 自排、許願要照劃假順序：輪到自己、而且還沒送出
    // 這個職務有啟用「全公司」順序就照全公司，不然照自己門市
    function grp(b, st) {
      let cg = st.role + '|全公司';
      return (cg in b.get('turn', {})) ? cg : st.role + '|' + st.store;
    }
    function turnOk(t, b, me, st) {
      let g = grp(b, st);
      let turn = b.get('turn', {});
      return !(t == '自排' || t == '許願')
        || (!(me in b.get('sub', {})) && (!(g in turn) || turn[g] == me || turn[g] == ''));
    }
    // 送出：只能加自己的送出紀錄、把自己這組換到下一位
    function staffSubmit(m) {
      let c = cfg();
      let me = email();
      let st = c.staffMap[me];
      let b = resource.data;
      let g = grp(b, st);
      let a = request.resource.data;
      let bs = b.get('sub', {});
      let as = a.get('sub', {});
      let bt = b.get('turn', {});
      let at = a.get('turn', {});
      return windowOpen(c.window, request.time.toMillis())
        && a.diff(b).affectedKeys().hasOnly(['sub', 'turn', 'last'])
        && a.last.op == 'submit'
        && as.diff(bs).affectedKeys().hasOnly([me]) && (me in as) && !(me in bs)
        && at.diff(bt).affectedKeys().hasOnly([g])
        && ((g in bt && bt[g] != '') ? (bt[g] == me && nextOk(b, g, me, at.get(g, ''))) : at.get(g, '-') == bt.get(g, '-'));
    }
    // 下一位：順序裡的下一個人；如果他已經被代送出，可以跳到後面還沒送出的人
    function nextOk(b, g, me, t) {
      let list = b.ord[g];
      let i = b.oi[g][me];
      let nx = i + 1 < list.size() ? list[i + 1] : '';
      let sub = b.get('sub', {});
      return t == nx || ((nx in sub) && (t == '' || ((t in b.oi[g]) && b.oi[g][t] > i + 1 && !(t in sub))));
    }
    function staffAdd(m, a, b, k, s, me, st) {
      let e = a.b[k];
      return !(k in b.b) && (k in a.b)
        && e.e == me && e.by == me && staffType(e.t) && turnOk(e.t, b, me, st)
        && e.r == st.role && e.st == st.store && e.sl == s
        && k == e.d + '_' + me
        && e.d.matches(m + '-[0-9][0-9]')
        && b.pm[e.d + '|' + st.role + '|' + st.store] == s
        && a.c[s] == b.c.get(s, 0) + 1
        && (b.q[s] < 0 || a.c[s] <= b.q[s]);
    }
    function staffDel(a, b, k, s, me, st) {
      let e = b.b[k];
      return (k in b.b) && !(k in a.b)
        && e.e == me && e.by == me && staffType(e.t) && turnOk(e.t, b, me, st) && e.sl == s
        && a.c[s] == b.c[s] - 1;
    }

    // 操作紀錄：只能用自己的名字新增，管理員能看
    match /logs/{id} {
      allow create: if email() != '' && request.resource.data.email == email();
      allow read: if isAdmin();
    }
  }
}
